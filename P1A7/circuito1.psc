Algoritmo circuito1
	definir p,q como logico
	p <- verdadero
	q <- verdadero
	escribir "p      q        p AND q        NOT q     (p AND q) OR (NOT q)"
	escribir p,"-",q,"-",p y q,"-",no q, "-", (p y q) o(no q)
	p <- verdadero
	q <- falso
	escribir "p      q        p AND q        NOT q     (p AND q) OR (NOT q)"
	escribir p,"-",q,"-",p y q,"-",no q, "-", (p y q) o(no q)
	p <- falso
	q <- verdadero
	escribir "p      q        p AND q        NOT q     (p AND q) OR (NOT q)"
	escribir p,"-",q,"-",p y q,"-",no q, "-", (p y q) o(no q)
	p <- falso
	q <- falso
	escribir "p      q        p AND q        NOT q     (p AND q) OR (NOT q)"
	escribir p,"-",q,"-",p y q,"-",no q, "-", (p y q) o(no q)
	
	
FinAlgoritmo
