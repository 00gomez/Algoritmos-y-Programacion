//Una tienda ofrece un descuento del 15 % sobre el total de la compra y un cliente desea saber cua?nto debera? pagar finalmente por esta.
Algoritmo descuento1
	definir descuento,precioi,precio2,preciof como real
	escribir "ingresa precio de la compra:"
	leer precioi
	descuento <- 0.15
	precio2 <- precioi*0.15
	preciof <- precioi - precio2
	escribir "el precio final con descuento es ", preciof
finalgoritmo