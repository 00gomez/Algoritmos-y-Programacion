//realizar un algoritmo en pseudocodigo para convertir grados celcius a grados kelvin y fahrenheit
Algoritmo celsiuskelvinfahrenheit
	definir c,k,f Como Real
	escribir "ingresa temperatura en celcius:"
	leer c
	k <- c * 274.5
	f <- c * 33.8
	
	escribir "La temperatura en  Kelvin es ",k
	escribir "La temperatura en  Fahrenheit es ",f
	
FinAlgoritmo
