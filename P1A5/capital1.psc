//EMILIANO GOMEZ CENTENO
//una persona invierte su capital en un banco y desea saber cuanto dinero ganara despues de un mes si la entidad pagar a razon
//del 2% mensual
Algoritmo capital1
	definir capital,porcentaje,ganancia Como Real
	escribir "ingresa cantidad del capital:"
	leer capital
	porcentaje <- 0.02
	ganancia <- capital*porcentaje
	escribir "la ganancia despues de un mes es ",ganancia
	
	
FinAlgoritmo
