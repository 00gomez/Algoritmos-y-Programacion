//Un estudiante desea saber cual sera su calificacion final en el curso de Algoritmos, con los siguientes Items de calificaciones: Primer parcial: 20 % Segundo parcial: 20 % Pra?ctica: 35 % Parcial final: 25 %.
Algoritmo calificacion
	DEFINIR primerp,segundop,practica,parcialf,cf Como Real
	primerp <- 20
	segundop <-20
	practica <-35
	parcialf <- 25
	cf <- primerp+segundop+practica+parcialf
	escribir "califacion final:" ,  cf
	
	
FinAlgoritmo
